# Copy to proto/.env and fill in. proto/.env is git-ignored.

# local = laptop stand-ins (SQLite, in-memory queue). gcp = real Google Cloud services.
RUN_MODE=local

# How the agent reaches Gemini. Pick one:
#  A) Google Cloud project (recommended, same path as Cloud Run, no key):
#     run `gcloud auth application-default login`, set TRUE and fill in the project.
#  B) No Google Cloud project: set FALSE and paste a free key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_API_KEY=

# Where Gemini is called. Gemini 3.x is served from "global", not from single regions like Sydney.
GOOGLE_CLOUD_LOCATION=global

# Model names (check the current list before the demo)
GEMINI_MODEL=gemini-3.6-flash
JUDGE_MODEL=gemini-3.1-pro-preview

# mock = scripted model for tests without network. gemini = real model.
LLM_MODE=gemini
