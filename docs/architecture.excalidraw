      "updated": 1,
      "link": null,
      "locked": false,
      "type": "text",
      "id": "steps",
      "x": 40,
      "y": 1005,
      "width": 603.9000000000001,
      "height": 247.5,
      "text": "1  Web shop sends a stock-out event when a purchase\n    finds no stock\n2  The event wakes the recovery agent (repeats skipped)\n3  Gemini decides what to check next\n4  Agent checks stock, loyalty, similar products,\n    and whether the sell-out is real\n5  Agent requests a supplier order\n    (big orders wait for a human OK)\n6  Order leaves via the controlled exit\n7  Agent writes a personalised offer (tool service checks it)\n8  Customer gets it via the API front door",
      "originalText": "1  Web shop sends a stock-out event when a purchase\n    finds no stock\n2  The event wakes the recovery agent (repeats skipped)\n3  Gemini decides what to check next\n4  Agent checks stock, loyalty, similar products,\n    and whether the sell-out is real\n5  Agent requests a supplier order\n    (big orders wait for a human OK)\n6  Order leaves via the controlled exit\n7  Agent writes a personalised offer (tool service checks it)\n8  Customer gets it via the API front door",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 198
    },
